{
  "name": "lab-01-socket-io-api",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time chat server: Socket.IO, Node.js 24, TypeScript 7",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --watch src/main.ts",
